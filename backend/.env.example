# PostgreSQL connection URL, for example:
# postgresql+psycopg://username:password@localhost:5432/mediassist
DATABASE_URL=

# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# React/Vite development server origin.
FRONTEND_URL=http://localhost:3000

# JWT access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API key for AI assistant (leave blank for demo/fallback mode)
OPENAI_API_KEY=
